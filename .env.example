# ==========================================================================
#  Хаттама AI — шаблон ключей и конфигурации LLM
#  Скопируйте в .env и заполните. Файл .env не коммитится в Git.
# ==========================================================================

# --- OpenAI (первичный LLM-провайдер) ---
# Если OPENAI_API_KEY заполнен — используется OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- NVIDIA NIM (резервный) ---
# Используется, если OPENAI_API_KEY пуст.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Распознавание речи (всегда локально, без облака) ---
WHISPER_MODEL=small              # tiny | base | small | medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Сервер ---
HOST=0.0.0.0
PORT=8000