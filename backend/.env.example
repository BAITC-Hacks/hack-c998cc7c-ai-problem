# Copy this file to backend/.env. No secrets belong in frontend or root .env.
DEFAULT_MODE=HYBRID
DEFAULT_ASR_MODE=API
# Provider base URL including version prefix, without /audio/transcriptions.
# Requires verbose_json with timestamped segments. May differ from text provider.
ASR_API_URL=
ASR_API_MODEL=
ASR_API_KEY=
ASR_CHUNK_SECONDS=600
# Default ASR location: backend/models/small (absolute path also accepted).
# WHISPER_MODEL=C:/path/to/local/faster-whisper-small
LLM_LOCAL_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=local-model
# Text provider base URL without /chat/completions, model ID, and secret key.
# HYBRID is the default for new uploads; transcript consent is required.
LLM_HYBRID_URL=
LLM_HYBRID_MODEL=
LLM_API_KEY=
MAX_UPLOAD_MB=250
MAX_AUDIO_SECONDS=14400
HOST=127.0.0.1
PORT=8000
# Public demo: password protects this entire shared workspace, not individual users.
PUBLIC_MODE=false
APP_AUTH_USER=demo
APP_AUTH_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# For a Quick Tunnel add *.trycloudflare.com and set MAX_UPLOAD_MB=90.
# PUBLIC_MODE=true requires HTTPS and a password of at least 16 characters.
# Optional system FFmpeg override; otherwise use bundled imageio-ffmpeg.
# FFMPEG=C:/tools/ffmpeg/bin/ffmpeg.exe
# PDF_FONT=C:/Windows/Fonts/arial.ttf
