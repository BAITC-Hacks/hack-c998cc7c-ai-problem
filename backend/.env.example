# Copy this file to backend/.env. No secrets belong in frontend or root .env.
# Default ASR location: backend/models/small (absolute path also accepted).
# WHISPER_MODEL=C:/path/to/local/faster-whisper-small
LLM_LOCAL_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=local-model
# HYBRID is used only when selected with consent for a meeting.
LLM_HYBRID_URL=
LLM_HYBRID_MODEL=
LLM_API_KEY=
MAX_UPLOAD_MB=250
MAX_AUDIO_SECONDS=14400
HOST=127.0.0.1
PORT=8000
# Optional system FFmpeg override; otherwise use bundled imageio-ffmpeg.
# FFMPEG=C:/tools/ffmpeg/bin/ffmpeg.exe
# PDF_FONT=C:/Windows/Fonts/arial.ttf
